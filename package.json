{
  "name": "convivium",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @convivium/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres",
    "db:generate": "pnpm --filter @convivium/db generate",
    "db:migrate": "pnpm --filter @convivium/db migrate",
    "db:seed": "pnpm --filter @convivium/db seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "autoprefixer": "^10.4.20",
    "node-html-parser": "^6.1.13",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
