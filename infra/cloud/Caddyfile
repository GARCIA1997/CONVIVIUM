# Dominios en .env (APP_DOMAIN, MENU_DOMAIN). Caddy obtiene los certificados TLS automáticamente.
{$APP_DOMAIN} {
  # Admin remoto (/admin/), API y documentación (/docs), sincronización de nodos (/v1/sync)
  reverse_proxy api:4000
}
{$MENU_DOMAIN} {
  # Menú digital público de cada sucursal (el QR apunta aquí): https://menu.dominio/m/<sucursal>, con sus fotos en /media/
  @menu path /m/* /media/*
  handle @menu { reverse_proxy api:4000 }
  handle { respond "CONVIVIUM" 404 }
}
