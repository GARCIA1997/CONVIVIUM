{
  "name": "@convivium/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p .",
    "generate": "drizzle-kit generate",
    "migrate": "tsx -e \"import('./src/migrate.ts').then(m=>m.runMigrations(process.env.DATABASE_URL ?? 'postgres://convivium:convivium@localhost:5432/convivium')).then(()=>console.log('migraciones al día'))\"",
    "seed": "tsx src/seed.ts && tsx src/seed-inventory.ts",
    "seed:ventas": "tsx src/seed-sales.ts",
    "setup": "tsx src/setup.ts",
    "seed:carta": "tsx src/seed-carta.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.1",
    "@types/bcryptjs": "^2.4.6"
  }
}
