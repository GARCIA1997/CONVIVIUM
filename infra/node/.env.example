# Copiar a .env en el mini-PC. Generar secretos con: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
# Vinculación con la nube (opcional: sin estos datos el nodo opera 100 % local)
CLOUD_URL=https://api.convivium.mx
NODE_TOKEN=
BRANCH_ID=
# Base pública del menú digital para el QR (en la nube). Vacío = convivium.local
PUBLIC_MENU_URL=https://menu.convivium.mx
